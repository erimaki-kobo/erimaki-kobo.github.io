"moviepy.editor": "from moviepy import VideoFileClip (every class is at the top now; from moviepy import * also works). 1.x: from moviepy.editor import *",
"moviepy.video.fx.all": "from moviepy import vfx: the effects are classes in moviepy.video.fx (vfx.Resize, vfx.FadeIn, ...)",
"moviepy.audio.fx.all": "from moviepy import afx: the effects are classes in moviepy.audio.fx (afx.MultiplyVolume, afx.AudioFadeIn, ...)",
"moviepy.video.compositing.concatenate": "from moviepy import concatenate_videoclips (it now lives in moviepy.video.compositing.CompositeVideoClip)",
"moviepy.video.compositing.transitions": "from moviepy import vfx: vfx.CrossFadeIn, vfx.CrossFadeOut, vfx.SlideIn, vfx.SlideOut",
"moviepy.video.io.html_tools": "moviepy.video.io.display_in_notebook",
"moviepy.video.io.preview": "moviepy.video.io.ffplay_previewer",
